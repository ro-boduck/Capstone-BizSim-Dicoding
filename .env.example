# BizSim Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your Supabase credentials.
# Get these from: https://supabase.com/dashboard → Project Settings → API

# Backend Credentials (used by Express server, keep private)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key

# Frontend Credentials (used by Next.js client, prefix exposes to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server Settings
PORT=3000
NODE_ENV=development
