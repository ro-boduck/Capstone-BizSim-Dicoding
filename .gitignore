# =============================================================
# BizSim – Root .gitignore
# =============================================================

# ---------------------------------------------------------------
# Next.js build output
# ---------------------------------------------------------------
.next/
out/

# ---------------------------------------------------------------
# AI agent tooling (not part of the app)
# ---------------------------------------------------------------
.agents/
skills-lock.json

# ---------------------------------------------------------------
# Python – ai-service
# ---------------------------------------------------------------
ai-service/venv/
ai-service/__pycache__/
ai-service/**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
.Python
*.egg-info/
.eggs/
*.egg

# Large training dataset (~20 MB – keep locally, not in repo)
ai-service/synthetic_umkm_data.csv

# Trained model binaries – large files, regeneratable via training
ai-service/model/*.keras
ai-service/model/*.pkl
# Keep scaler_params.json (small config, needed at runtime)

# ---------------------------------------------------------------
# Node.js – frontend & backend
# ---------------------------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
frontend/dist-ssr/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------
.env
.env.local
.env.*.local
frontend/.env
backend/.env
ai-service/.env

# ---------------------------------------------------------------
# Runtime / generated data
# ---------------------------------------------------------------
# Simulation history is runtime data – exclude to avoid conflicts
backend/data/simulations.json

# ---------------------------------------------------------------
# OS & editor artifacts
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json

# Agent Traces
AGENTS.md
CLAUDE.md
app-page-backup.tsx
